sub_start_1:Start {
    ports_data_out = `["t", "foo"]`;
    ports_exec_out = `["out", "foo"]`;
}

sub_end_2:End {
    ports_data_in = `["t"]`;
    ports_exec_in = `["rrrreee", "in"]`;
}

iteratetransitions_3:Loop
checknac_4:Match {
    file = "rules/input_without_token.od";
    n = 1;
}

:Conn_exec (sub_start_1 -> iteratetransitions_3) {from="out"; to="in";}
:Conn_data (sub_start_1 -> iteratetransitions_3) {from="t"; to="in";}
:Conn_exec (iteratetransitions_3 -> checknac_4) {from="it"; to="in";}
:Conn_data (iteratetransitions_3 -> checknac_4) {from="out"; to="in";}
:Conn_exec (checknac_4 -> iteratetransitions_3) {from="success"; to="in";}
:Conn_exec (checknac_4 -> sub_end_2) {from="fail"; to="in";}
:Conn_data (iteratetransitions_3 -> sub_end_2) {from="out"; to="t";}
