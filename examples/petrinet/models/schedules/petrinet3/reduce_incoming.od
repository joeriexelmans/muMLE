sub_start_1:Start {
    ports_data_out = `["t", "foo"]`;
    ports_exec_out = `["out", "foo"]`;
}

sub_end_2:End {
    ports_data_in = `[]`;
    ports_exec_in = `["rrrreee", "in"]`;
}

iterateplaces_3:Loop
incomingplaces_4:Match {
    file = "rules/all_incoming.od";
    n = 1;
}

reduceplace_5:Rewrite {
    file = "rules/reduce_incoming.od";
}

:Conn_exec (sub_start_1 -> incomingplaces_4) {from="out"; to="in";}
:Conn_data (sub_start_1 -> incomingplaces_4) {from="t"; to="in";}
:Conn_exec (incomingplaces_4 -> iterateplaces_3) {from="fail"; to="in";}
:Conn_exec (incomingplaces_4 -> iterateplaces_3) {from="success"; to="in";}
:Conn_data (incomingplaces_4 -> iterateplaces_3) {from="out"; to="in";}
:Conn_data (iterateplaces_3 -> reduceplace_5) {from="out"; to="in";}
:Conn_exec (iterateplaces_3 -> sub_end_2) {from="out"; to="in";}
:Conn_exec (iterateplaces_3 -> reduceplace_5) {from="it"; to="in";}
:Conn_exec (reduceplace_5 -> iterateplaces_3) {from="out"; to="in";}
